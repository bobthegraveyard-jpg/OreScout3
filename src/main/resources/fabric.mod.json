{
  "schemaVersion": 1,
  "id": "orescout",
  "version": "${version}",
  "name": "OreScout",
  "description": "Displays client-side highlights from an independent seed-derived ore coordinate map.",
  "authors": [
    "OreScout"
  ],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.orescout.client.OreScoutClient"
    ]
  },
  "mixins": [
    {
      "config": "orescout.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
